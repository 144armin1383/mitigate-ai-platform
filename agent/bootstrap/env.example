# MITIGATE AI Environment Template (Placeholders Only)
# DO NOT COMMIT REAL SECRETS. Keep real values outside Git.
# Copy this file to .env at the repository root and replace placeholders locally.

# Environment identity
MITIGATE_AI_ENVIRONMENT_NAME="dev"
MITIGATE_AI_DEFAULT_PROJECT_ID="default"

# Repository and data roots (adjust if needed)
MITIGATE_AI_REPOSITORY_ROOT="/path/to/clone"  # e.g., /srv/mitigate/mitigate-ai-platform
MITIGATE_AI_DATA_ROOT="${MITIGATE_AI_REPOSITORY_ROOT}/agent/.data"
MITIGATE_AI_MEMORY_ROOT="${MITIGATE_AI_DATA_ROOT}/memory"

# Provider configuration (placeholders only)
MITIGATE_AI_PROVIDER="local"              # e.g., openai | anthropic | gemini | local | custom
MITIGATE_AI_PROVIDER_API_KEY="<SECRET>"   # PLACEHOLDER ONLY - set securely outside Git
MITIGATE_AI_PROVIDER_BASE_URL="<URL>"     # PLACEHOLDER ONLY
MITIGATE_AI_PROVIDER_MODEL="<MODEL>"      # PLACEHOLDER ONLY

# Site adapter selection (provider-neutral)
MITIGATE_AI_SITE_ADAPTER="generic"        # e.g., wordpress | lovable | react | nextjs | static | php | generic_git | custom

# Runtime configuration (placeholders only)
MITIGATE_AI_RUNTIME_HOST="127.0.0.1"
MITIGATE_AI_RUNTIME_PORT="8080"
MITIGATE_AI_API_TOKEN="<SECRET>"          # PLACEHOLDER ONLY - set securely outside Git

# Notes:
# - Never commit .env with real secrets.
# - Set secrets via secure environment injection or secret management tooling.
