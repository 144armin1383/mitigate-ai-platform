# MITIGATE AI Portable Bootstrap Environment Template
# Copy this file to a local environment file (e.g., .env.local) and replace
# placeholder values with machine-appropriate settings outside version control.
# This template intentionally contains only placeholders and is safe to commit.

# Example: staging-eu-1 or local-dev
MITIGATE_AI_ENVIRONMENT_NAME="<ENVIRONMENT_NAME>"

# Example: project-1234 or wp-example-site
MITIGATE_AI_DEFAULT_PROJECT_ID="<DEFAULT_PROJECT_ID>"

# Example: /path/to/repository/root
MITIGATE_AI_REPOSITORY_ROOT="<REPOSITORY_ROOT>"

# Example: /path/to/data/storage
MITIGATE_AI_DATA_ROOT="<DATA_ROOT>"

# Example: /path/to/memory/storage
MITIGATE_AI_MEMORY_ROOT="<MEMORY_ROOT>"

# Example: openai, anthropic, azure_openai, or custom
MITIGATE_AI_PROVIDER="<PROVIDER>"

# Example: place the provider access value here
MITIGATE_AI_PROVIDER_API_KEY="<PROVIDER_API_KEY>"

# Example: https://api.provider.example.com/v1
MITIGATE_AI_PROVIDER_BASE_URL="<PROVIDER_BASE_URL>"

# Example: gpt-4o-mini or another model identifier
MITIGATE_AI_PROVIDER_MODEL="<PROVIDER_MODEL>"

# Example: wordpress, lovable, nextjs, or generic
MITIGATE_AI_SITE_ADAPTER="<SITE_ADAPTER>"

# Example: host.example.com
MITIGATE_AI_RUNTIME_HOST="<RUNTIME_HOST>"

# Example: 51000
MITIGATE_AI_RUNTIME_PORT="<RUNTIME_PORT>"

# Example: use a long, randomly generated value
MITIGATE_AI_API_TOKEN="<API_TOKEN>"
