{
  "version": "1.0",
  "project_id": "example-project",
  "project_name": "Example Portable Web Project",
  "repository": "https://github.com/your-org/your-repo",
  "default_branch": "main",
  "site_type": "web",
  "cms_type": "custom",
  "adapter": {
    "site_adapter_name": "generic",
    "provider_adapter_name": "local"
  },
  "canonical_url": "https://www.example.com",
  "allowed_paths": ["/", "/blog", "/assets"],
  "denied_paths": ["/admin", "/private"],
  "environment": {
    "name": "dev",
    "variables": {}
  },
  "seo_enabled": true,
  "performance_monitoring_enabled": true,
  "availability_monitoring_enabled": true,
  "security_monitoring_enabled": true,
  "accessibility_monitoring_enabled": true,
  "ecommerce_enabled": false,
  "autonomous_low_risk_fixes": true,
  "autonomous_medium_risk_fixes": false,
  "memory_enabled": true,
  "metadata": {
    "description": "Provider-neutral project configuration template. Do not include secrets.",
    "notes": "Set provider credentials externally via environment variables or secret manager."
  },
  "profiles": {
    "wordpress": {
      "cms_type": "wordpress",
      "site_type": "php",
      "adapter": { "site_adapter_name": "wordpress", "provider_adapter_name": "local" }
    },
    "lovable": {
      "cms_type": "lovable",
      "site_type": "static",
      "adapter": { "site_adapter_name": "lovable", "provider_adapter_name": "local" }
    },
    "react": {
      "cms_type": "custom",
      "site_type": "react",
      "adapter": { "site_adapter_name": "react", "provider_adapter_name": "local" }
    },
    "nextjs": {
      "cms_type": "custom",
      "site_type": "nextjs",
      "adapter": { "site_adapter_name": "nextjs", "provider_adapter_name": "local" }
    },
    "static": {
      "cms_type": "custom",
      "site_type": "static",
      "adapter": { "site_adapter_name": "static", "provider_adapter_name": "local" }
    },
    "php": {
      "cms_type": "custom",
      "site_type": "php",
      "adapter": { "site_adapter_name": "php", "provider_adapter_name": "local" }
    },
    "generic_git": {
      "cms_type": "custom",
      "site_type": "generic_git",
      "adapter": { "site_adapter_name": "generic_git", "provider_adapter_name": "local" }
    },
    "custom": {
      "cms_type": "custom",
      "site_type": "web",
      "adapter": { "site_adapter_name": "custom", "provider_adapter_name": "custom" }
    }
  }
}
