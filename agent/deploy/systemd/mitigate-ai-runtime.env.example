# MITIGATE AI Runtime Private API - Example Environment File (placeholders only)
# WARNING: Do NOT commit the real environment file to Git.
# Store the real file at /etc/mitigate-ai/runtime.env with permissions 0600 and root ownership.
# Replace all placeholder values enclosed in <...> before starting the service.

# Bind address and port (localhost-only binding is recommended for production)
MITIGATE_AI_HOST=<127.0.0.1>
MITIGATE_AI_PORT=<8765>

# Absolute paths for repository and data roots
MITIGATE_AI_DATA_ROOT=</absolute/path/to/data-root>
MITIGATE_AI_REPOSITORY_ROOT=</srv/mitigate/mitigate-ai-platform>

# Application runtime configuration
MITIGATE_AI_DEFAULT_PROJECT_ID=<your-default-project-id>
MITIGATE_AI_ENVIRONMENT_NAME=<environment-name>

# Authentication configuration
# Name of the environment variable containing the API token (commonly MITIGATE_AI_API_TOKEN)
MITIGATE_AI_AUTH_TOKEN_ENV=<MITIGATE_AI_API_TOKEN>
# The actual API token value (SECRET). Replace with a real token at runtime only.
MITIGATE_AI_API_TOKEN=<REPLACE_WITH_RUNTIME_PRIVATE_API_TOKEN_DO_NOT_COMMIT>
