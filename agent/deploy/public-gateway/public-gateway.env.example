# MITIGATE AI portable public gateway
# Copy to /etc/mitigate-ai/public-gateway.env on the target server.
# Never commit the real password.

# Modes: ip-test | domain
MITIGATE_PUBLIC_MODE=ip-test

# For ip-test use auto to detect the server public IPv4.
# For domain mode set a real hostname such as ai.example.com.
MITIGATE_PUBLIC_HOST=auto

# Default test port avoids conflicts with an existing website/Nginx.
MITIGATE_PUBLIC_PORT=8443

# Canvas / application upstream. This can point to another local service on future projects.
MITIGATE_PUBLIC_UPSTREAM=http://127.0.0.1:8000

MITIGATE_PUBLIC_USERNAME=admin
MITIGATE_PUBLIC_PASSWORD=CHANGE_ME

# TLS modes: selfsigned | letsencrypt
# ip-test defaults to selfsigned; domain production should use letsencrypt.
MITIGATE_PUBLIC_TLS=selfsigned

# Required when using letsencrypt.
MITIGATE_LETSENCRYPT_EMAIL=
