{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mitigate://schemas/flowspec-v1",
  "title": "MITIGATE FlowSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "flow_id",
    "project_id",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "flow_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "metadata": {
      "type": "object"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "step_id",
          "task_type"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "minLength": 1
          },
          "task_type": {
            "type": "string",
            "minLength": 1
          },
          "dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "payload": {
            "type": "object"
          }
        }
      }
    }
  }
}
